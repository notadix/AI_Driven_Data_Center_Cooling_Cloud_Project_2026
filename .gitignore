~$*.docx
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Python virtualenv
.venv/
*.pyo
.env

# Pytest cache
.pytest_cache/
__pycache__/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Frontend build artifacts
src/frontend/dist/
dist/

# OS files
*.swp
*.swo

# Regeneratable dataset artifacts (run `python dataset/download_dataset.py`
# then `python dataset/preprocess_telemetry.py` to reproduce). Committing
# ~50MB of binary data/tensors here would bloat the repo with no diffing
# benefit; the project's own architecture already designates S3 as the
# data lake for this.
dataset/raw/*
!dataset/raw/.gitkeep
dataset/processed/*
!dataset/processed/.gitkeep


# Per-seed RL experiment checkpoints (only the selected best agent is committed)
models/rl_runs/
